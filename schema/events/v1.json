{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mandate event v1",
  "description": "The wire form, for the checked-in JSON Schema only.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "description": "`mandate.core`, or `mandate.app.<provider>`.",
      "type": "string"
    },
    "tenant": {
      "type": "string"
    },
    "occurred_at": {
      "description": "RFC 3339.",
      "type": "string"
    },
    "kid": {
      "description": "Names the Ed25519 key that signed the envelope; it belongs to one source.",
      "type": "string"
    },
    "signature": {
      "description": "Ed25519 over the canonical JSON (sorted keys, no whitespace) of every other field,\nbase64url without padding.",
      "type": "string"
    }
  },
  "required": [
    "id",
    "source",
    "tenant",
    "occurred_at",
    "kid",
    "signature"
  ],
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "approval.requested.v1"
        },
        "data": {
          "type": "object",
          "properties": {
            "approval": {
              "type": "string",
              "format": "uuid"
            },
            "agent": {
              "type": "string"
            }
          },
          "required": [
            "approval",
            "agent"
          ]
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "approval.decided.v1"
        },
        "data": {
          "type": "object",
          "properties": {
            "approval": {
              "type": "string",
              "format": "uuid"
            },
            "decision": {
              "$ref": "#/$defs/Decision"
            },
            "by": {
              "type": "string"
            },
            "via": {
              "description": "Where the decision came from; absent on events from before channels.",
              "anyOf": [
                {
                  "$ref": "#/$defs/ChannelKind"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "approval",
            "decision",
            "by"
          ]
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "description": "The expiry sweep found it undecided past `expires_at`.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "approval.expired.v1"
        },
        "data": {
          "type": "object",
          "properties": {
            "approval": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "approval"
          ]
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "conversation.started.v1"
        },
        "data": {
          "type": "object",
          "properties": {
            "conversation": {
              "type": "string",
              "format": "uuid"
            },
            "channel": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ChannelKind"
                },
                {
                  "type": "null"
                }
              ]
            },
            "handoff_from": {
              "description": "The conversation this one continues (a handoff, or a thread whose session ended).",
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            }
          },
          "required": [
            "conversation"
          ]
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "description": "eve replaced a stranded session; the conversation continues on the new one.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "conversation.session_replaced.v1"
        },
        "data": {
          "type": "object",
          "properties": {
            "conversation": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "conversation"
          ]
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "description": "A member spoke in the conversation for the first time.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "conversation.joined.v1"
        },
        "data": {
          "type": "object",
          "properties": {
            "conversation": {
              "type": "string",
              "format": "uuid"
            },
            "member": {
              "type": "string"
            }
          },
          "required": [
            "conversation",
            "member"
          ]
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "channel.installed.v1"
        },
        "data": {
          "type": "object",
          "properties": {
            "installation": {
              "type": "string",
              "format": "uuid"
            },
            "kind": {
              "$ref": "#/$defs/ChannelKind"
            },
            "by": {
              "type": "string"
            }
          },
          "required": [
            "installation",
            "kind",
            "by"
          ]
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "description": "The installation's agent was set or cleared.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "channel.updated.v1"
        },
        "data": {
          "type": "object",
          "properties": {
            "installation": {
              "type": "string",
              "format": "uuid"
            },
            "kind": {
              "$ref": "#/$defs/ChannelKind"
            },
            "by": {
              "type": "string"
            }
          },
          "required": [
            "installation",
            "kind",
            "by"
          ]
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "description": "An admin removed it, or the provider uninstalled the app or revoked its tokens.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "channel.removed.v1"
        },
        "data": {
          "type": "object",
          "properties": {
            "installation": {
              "type": "string",
              "format": "uuid"
            },
            "kind": {
              "$ref": "#/$defs/ChannelKind"
            },
            "actor": {
              "$ref": "#/$defs/Actor"
            }
          },
          "required": [
            "installation",
            "kind",
            "actor"
          ]
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "channel_identity.linked.v1"
        },
        "data": {
          "type": "object",
          "properties": {
            "member": {
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/ChannelKind"
            }
          },
          "required": [
            "member",
            "kind"
          ]
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "description": "The member unlinked, or was removed from the org.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "channel_identity.unlinked.v1"
        },
        "data": {
          "type": "object",
          "properties": {
            "member": {
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/ChannelKind"
            },
            "actor": {
              "$ref": "#/$defs/Actor"
            }
          },
          "required": [
            "member",
            "kind",
            "actor"
          ]
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "description": "The provider accepted a card or its edit; `cause` is the event that asked for it, and an\nabsent `member` is a thread card.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "notification.sent.v1"
        },
        "data": {
          "type": "object",
          "properties": {
            "kind": {
              "$ref": "#/$defs/ChannelKind"
            },
            "cause": {
              "type": "string",
              "format": "uuid"
            },
            "member": {
              "type": [
                "string",
                "null"
              ]
            },
            "approval": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            }
          },
          "required": [
            "kind",
            "cause"
          ]
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "description": "The output guard withheld an outgoing message; an absent `member` means no single speaker.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "message.withheld.v1"
        },
        "data": {
          "type": "object",
          "properties": {
            "agent": {
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/ChannelKind"
            },
            "reason": {
              "$ref": "#/$defs/WithheldReason"
            },
            "member": {
              "type": [
                "string",
                "null"
              ]
            },
            "conversation": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            }
          },
          "required": [
            "agent",
            "kind",
            "reason"
          ]
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "conversation.finished.v1"
        },
        "data": {
          "type": "object",
          "properties": {
            "conversation": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "conversation"
          ]
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "grant.created.v1"
        },
        "data": {
          "type": "object",
          "properties": {
            "grant": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "grant"
          ]
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "grant.revoked.v1"
        },
        "data": {
          "type": "object",
          "properties": {
            "grant": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "grant"
          ]
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "member.created.v1"
        },
        "data": {
          "type": "object",
          "properties": {
            "member": {
              "type": "string"
            },
            "actor": {
              "$ref": "#/$defs/Actor"
            }
          },
          "required": [
            "member",
            "actor"
          ]
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "member.updated.v1"
        },
        "data": {
          "type": "object",
          "properties": {
            "member": {
              "type": "string"
            },
            "actor": {
              "$ref": "#/$defs/Actor"
            }
          },
          "required": [
            "member",
            "actor"
          ]
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "member.removed.v1"
        },
        "data": {
          "type": "object",
          "properties": {
            "member": {
              "type": "string"
            },
            "actor": {
              "$ref": "#/$defs/Actor"
            }
          },
          "required": [
            "member",
            "actor"
          ]
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "organization.created.v1"
        },
        "data": {
          "type": "object",
          "properties": {
            "actor": {
              "$ref": "#/$defs/Actor"
            }
          },
          "required": [
            "actor"
          ]
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "description": "A person joined by their own sign-up or first sign-in, not through the directory.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "member.signed_up.v1"
        },
        "data": {
          "type": "object",
          "properties": {
            "member": {
              "type": "string"
            },
            "method": {
              "$ref": "#/$defs/SignInMethod"
            }
          },
          "required": [
            "member",
            "method"
          ]
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "description": "A session was created.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "member.signed_in.v1"
        },
        "data": {
          "type": "object",
          "properties": {
            "member": {
              "type": "string"
            },
            "method": {
              "$ref": "#/$defs/SignInMethod"
            }
          },
          "required": [
            "member",
            "method"
          ]
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "description": "The member picked this organization (the envelope's tenant) from several.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "organization.chosen.v1"
        },
        "data": {
          "type": "object",
          "properties": {
            "member": {
              "type": "string"
            }
          },
          "required": [
            "member"
          ]
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "setting.changed.v1"
        },
        "data": {
          "type": "object",
          "properties": {
            "by": {
              "type": "string"
            },
            "setting": {
              "$ref": "#/$defs/Setting"
            },
            "space": {
              "description": "The space a space-scoped setting was changed for.",
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "description": "The channel kind a per-kind setting was changed for.",
              "anyOf": [
                {
                  "$ref": "#/$defs/ChannelKind"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "by",
            "setting"
          ]
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "description": "SES accepted an email to the member; `cause` is the event that asked for it.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "email.sent.v1"
        },
        "data": {
          "type": "object",
          "properties": {
            "member": {
              "type": "string"
            },
            "template": {
              "$ref": "#/$defs/EmailTemplate"
            },
            "cause": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "member",
            "template",
            "cause"
          ]
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "description": "The member's address bounced for good; it is now suppressed.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "email.bounced.v1"
        },
        "data": {
          "type": "object",
          "properties": {
            "member": {
              "type": "string"
            },
            "template": {
              "$ref": "#/$defs/EmailTemplate"
            }
          },
          "required": [
            "member",
            "template"
          ]
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "description": "The member marked an email as spam; their address is now suppressed.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "email.complained.v1"
        },
        "data": {
          "type": "object",
          "properties": {
            "member": {
              "type": "string"
            },
            "template": {
              "$ref": "#/$defs/EmailTemplate"
            }
          },
          "required": [
            "member",
            "template"
          ]
        }
      },
      "required": [
        "type",
        "data"
      ]
    }
  ],
  "$defs": {
    "Decision": {
      "type": "string",
      "enum": [
        "approved",
        "denied"
      ]
    },
    "ChannelKind": {
      "type": "string",
      "enum": [
        "web",
        "slack",
        "whatsapp",
        "sms"
      ]
    },
    "Actor": {
      "description": "Who caused a lifecycle change.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "member"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "directory"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "system"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "WithheldReason": {
      "description": "Why the output guard withheld an outgoing message.",
      "type": "string",
      "enum": [
        "guard_blocked",
        "guard_error"
      ]
    },
    "SignInMethod": {
      "description": "How a person proved who they are; a later step (an emailed code, two-step) doesn't change it.",
      "type": "string",
      "enum": [
        "password",
        "magic_code",
        "sso"
      ]
    },
    "Setting": {
      "description": "Which setting changed; never its value.",
      "oneOf": [
        {
          "description": "The member turned two-step (TOTP) on.",
          "type": "string",
          "const": "two_step"
        },
        {
          "description": "`channels.streaming` (docs/settings.md), with the `kind` it applies to.",
          "type": "string",
          "const": "channel_streaming"
        },
        {
          "description": "`threads.multiplayer`, for the org or one `space`.",
          "type": "string",
          "const": "thread_multiplayer"
        },
        {
          "description": "`spaces.guest_tool_calls`, for the org or one `space`.",
          "type": "string",
          "const": "guest_tool_calls"
        },
        {
          "description": "The member's `approvals.channels`.",
          "type": "string",
          "const": "approval_channels"
        },
        {
          "description": "`approvals.thread_cards`, for the org or one `space`.",
          "type": "string",
          "const": "thread_approval_cards"
        }
      ]
    },
    "EmailTemplate": {
      "description": "Which email went out; never its content or address.",
      "type": "string",
      "enum": [
        "approval_requested"
      ]
    }
  }
}
