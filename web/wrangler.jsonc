{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mandate-web",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  // Served only on its own domain: no *.workers.dev address and no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  // AWS dev (docs/deploy.md, the web app), from web/:
  //   CLOUDFLARE_ENV=dev VITE_MANDATE_API_URL=https://api.oryxa.in npm run build && npx wrangler deploy --env dev
  // Both are fixed at build time: Cloudflare's Vite plugin picks the environment when it builds
  // (without CLOUDFLARE_ENV, `--env dev` at deploy is ignored and the top-level Worker goes out),
  // and the core's address is compiled into the browser code and the CSP's connect-src.
  "env": {
    "dev": {
      "name": "mandate-web-dev",
      "routes": [{ "pattern": "app.oryxa.in", "custom_domain": true }]
    }
  }
}
