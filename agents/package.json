  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.92",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-logs-otlp-proto": "0.223.2",
    "@opentelemetry/exporter-trace-otlp-proto": "0.223.2",
    "@opentelemetry/instrumentation-undici": "0.33.0",
    "@opentelemetry/resources": "2.12.1",
    "@opentelemetry/sdk-logs": "0.223.2",
    "@workflow/world-postgres": "5.5.0",
    "ai": "7.0.172",
    "eve": "1.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
